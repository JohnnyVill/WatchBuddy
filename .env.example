# TMDB API key (Bearer token from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# PostgreSQL connection string (e.g., Neon, Supabase)
DATABASE_URL=
# Set false only for a local PostgreSQL database without TLS.
DATABASE_SSL=true

# Secret key for session JWT signing (generate with: openssl rand -base64 32)
SESSION_SECRET=

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional metadata API override for isolated tests. Leave unset for normal use.
# TMDB_BASE_URL=http://127.0.0.1:4100/3
